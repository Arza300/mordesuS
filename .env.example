# Database (Neon)
# Pooled connection for the application runtime
DATABASE_URL=
# Direct connection for Prisma CLI (migrations, db push)
DIRECT_URL=

# Site
# Local: http://localhost:3000
# Production: https://mordesu.tech  (must match the domain users open)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Mordesu Studio
NEXT_PUBLIC_SITE_DESCRIPTION=Software development studio specializing in modern web applications.

# Better Auth (generate secret: openssl rand -hex 32)
BETTER_AUTH_SECRET=
# Must match NEXT_PUBLIC_SITE_URL in each environment (https on production)
# Production: https://mordesu.tech
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Set to 1 to skip env validation (CI / local tooling only)
# SKIP_ENV_VALIDATION=1
